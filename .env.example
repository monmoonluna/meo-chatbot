# Lấy API key tại: https://aistudio.google.com/app/apikey
# Free tier: ~quota theo ngày mỗi key, không cần thẻ tín dụng.
GEMINI_API_KEY=your_key_here

# Nhiều key để nhân quota free tier (server xoay vòng + tự nhảy key khi 1 key
# hết quota). Phân tách bằng dấu phẩy. Gộp chung với GEMINI_API_KEY ở trên.
# Mỗi key nên thuộc 1 Google project khác nhau để có quota độc lập.
# GEMINI_API_KEYS=key1,key2,key3,key4,key5
# (hoặc đánh số: GEMINI_API_KEY_1=... GEMINI_API_KEY_2=... ...)

# Ép dùng đúng 1 model (bỏ qua chuỗi fallback). Để trống = thử lần lượt
# 2.5-flash → 2.5-flash-lite → 2.0-flash → 2.0-flash-lite.
# GEMINI_MODEL=gemini-2.0-flash-lite

# CORS — production chỉ allow domain của team web
# ALLOWED_ORIGINS=https://yourwebsite.com,https://staging.yourwebsite.com
ALLOWED_ORIGINS=*

# Auth — nếu set, client phải gửi header `X-API-Key: <giá trị này>` cho /chat.
# Để trống = không yêu cầu key (chỉ nên dùng khi dev local).
# API_KEY=doi_thanh_chuoi_bi_mat_dai

# Rate limit — số request tối đa mỗi IP trong 60s (đặt 0 để tắt).
RATE_LIMIT_PER_MIN=20

# Response cache — câu hỏi đơn lượt (1 message) + topic auto được cache để
# không tốn quota Gemini lần 2 (LRU, evict câu cũ nhất). Số entry tối đa;
# đặt 0 để tắt cache.
MEO_REPLY_CACHE=256

# needs_vet rerank-gate — chunk severity=high chỉ bật cảnh báo thú y khi
# rerank_score >= ngưỡng này (giữ 9/9 recall cấp cứu, giảm over-trigger).
# Đặt 0 để tắt gate (về hành vi "any high").
MEO_NEEDS_VET_MIN_RR=0.5

# Relevance floor — chunk có score < ngưỡng này bị loại; nếu loại hết →
# bot trả lời "không đủ thông tin" thay vì bịa. 0.90 là mức an toàn (không
# loại nhầm câu hỏi tiếng Anh/hội thoại về mèo). Đặt 0 để tắt.
MEO_MIN_SCORE=0.90

# (Tuỳ chọn) HuggingFace cache để model file đi đường D:
# HF_HOME=D:\hf-cache
