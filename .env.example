# Lấy API key tại: https://aistudio.google.com/app/apikey
# Free tier: 1500 requests/ngày, không cần thẻ tín dụng
GEMINI_API_KEY=your_key_here

# CORS — production chỉ allow domain của team web
# ALLOWED_ORIGINS=https://yourwebsite.com,https://staging.yourwebsite.com
ALLOWED_ORIGINS=*

# Auth — nếu set, client phải gửi header `X-API-Key: <giá trị này>` cho /chat.
# Để trống = không yêu cầu key (chỉ nên dùng khi dev local).
# API_KEY=doi_thanh_chuoi_bi_mat_dai

# Rate limit — số request tối đa mỗi IP trong 60s (đặt 0 để tắt).
RATE_LIMIT_PER_MIN=20

# Relevance floor — chunk có score < ngưỡng này bị loại; nếu loại hết →
# bot trả lời "không đủ thông tin" thay vì bịa. 0.90 là mức an toàn (không
# loại nhầm câu hỏi tiếng Anh/hội thoại về mèo). Đặt 0 để tắt.
MEO_MIN_SCORE=0.90

# (Tuỳ chọn) HuggingFace cache để model file đi đường D:
# HF_HOME=D:\hf-cache
